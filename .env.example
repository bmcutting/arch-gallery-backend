
# ---- App ----
NODE_ENV=local
PORT=3000

# ---- Base de datos ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arch_gallery
DB_USERNAME=postgres
DB_PASSWORD=

# synchronize genera el esquema desde los modelos. Pasa a false en la Fase 9,
# cuando se active el sistema de migraciones.
DB_SYNCHRONIZE=true
DB_RUN_MIGRATIONS=false
# Ojo: borra el esquema entero al arrancar.
DB_DROP_SCHEMA=false

# Postgres local no habla TLS; un Postgres alojado normalmente si lo exige.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- Seguridad ----
# Swagger se sirve siempre salvo en produccion, donde requiere este flag.
SWAGGER_ENABLED=false
FRONTEND_URL=http://localhost:5173
# Allowlist separada por comas. Vacio cae a FRONTEND_URL.
CORS_ORIGINS=

# ---- Tokens ----
JWT_SECRET=
JWT_EXPIRATION_TIME=1d
JWT_ALGORITHM=HS256
# El refresh token no es un JWT (bytes aleatorios hasheados), solo caduca.
REFRESH_TOKEN_EXPIRATION_TIME=30d

# ---- Logging ----
LOG_LEVEL=info
LOG_HEALTHCHECK=false
